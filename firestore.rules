rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'cesar.santos16c@gmail.com';
    }

    // Ranking e rodadas: todo mundo lê, só o administrador altera.
    match /players/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rounds/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Palpites: cada participante grava só o próprio documento (id = uid do login).
    // Depois de salvo, o que já existe no documento (inclusive cada rodada) não pode mais ser alterado.
    // O administrador pode gravar e apagar qualquer um.
    match /bets/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && !resource.data.keys().hasAny(request.resource.data.diff(resource.data).affectedKeys());
      allow write: if isAdmin();
    }
  }
}
